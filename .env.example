# ---------------------------------------------------------------------------
# REEVITA storefront — environment
# Copy to .env.local and fill with your Supabase project credentials.
# Without these values the site runs in fully functional DEMO mode.
# ---------------------------------------------------------------------------

# Public (browser-safe) — Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL (SEO metadata + auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Online card payments are intentionally disabled in phase 1 (COD only in Egypt)
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENTS=false

# Public support line shown in the footer (overrides the catalogue default)
NEXT_PUBLIC_SUPPORT_PHONE=

# Optional distributed rate limiting (Upstash Redis REST); local memory is used when empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Backend-phase variables (server only — NEVER expose with NEXT_PUBLIC_)
# Needed only for local Supabase tooling / admin seeding, never at runtime.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SMS_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
CAPTCHA_ENABLED=false
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
